<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowser" preserve-order="true">

    <test name="Chrome Tests" preserve-order="true">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.HomePageTest"/>
            <class name="tests.CalendarTest"/>
            <class name="tests.OrganizationTest"/>
            <class name="tests.ContactTest"/>
        </classes>
    </test>

    <test name="Firefox Tests" preserve-order="true">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.HomePageTest"/>
            <class name="tests.CalendarTest"/>
            <class name="tests.OrganizationTest"/>
            <class name="tests.ContactTest"/>
        </classes>
    </test>

    <test name="Edge Tests" preserve-order="true">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.HomePageTest"/>
            <class name="tests.CalendarTest"/>
            <class name="tests.OrganizationTest"/>
            <class name="tests.ContactTest"/>
        </classes>
    </test>

</suite>